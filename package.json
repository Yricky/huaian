{
  "name": "huaian",
  "version": "1.0.0",
  "description": "A TypeScript-based Electron application with Vue 3",
  "main": "out/main/index.js",
  "homepage": "./",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:plugins": "node scripts/build-builtin-plugins.mjs",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build": "pnpm build:main && pnpm build:plugins && pnpm build:preload && pnpm build:renderer",
    "streaming-markdown:bench": "pnpm --filter @huaian/streaming-markdown bench",
    "streaming-markdown:build": "pnpm --filter @huaian/streaming-markdown build",
    "streaming-markdown:dev": "pnpm --filter @huaian/streaming-markdown dev",
    "streaming-markdown:test": "pnpm --filter @huaian/streaming-markdown test",
    "preview": "pnpm build && electron .",
    "dist": "pnpm build && electron-builder",
    "postinstall": "node scripts/rebuild-native.mjs"
  },
  "keywords": [
    "electron",
    "vue",
    "typescript",
    "vite"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.23.0",
  "devDependencies": {
    "@chenglou/pretext": "^0.0.7",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.2.0",
    "electron": "^39.5.1",
    "electron-builder": "^25.1.8",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.14",
    "vue": "^3.5.27",
    "vue-icons-plus": "^0.1.8",
    "vue-tsc": "^3.2.4"
  },
  "build": {
    "appId": "com.yricky.huaian",
    "productName": "huaian",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "asar": true,
    "mac": {
      "target": "dir"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@huaian/plugin-api": "workspace:*",
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/openai": "^3.0.66",
    "@ai-sdk/openai-compatible": "^1.0.39",
    "@faker-js/faker": "^10.4.0",
    "ai": "^6.0.193",
    "better-sqlite3": "^12.10.0",
    "jsonrepair": "^3.14.0",
    "lodash": "^4.18.1",
    "ollama-ai-provider-v2": "^1.5.5",
    "syntax-error": "^1.4.0",
    "vuedraggable": "^4.1.0",
    "zod": "^4.4.3"
  }
}
